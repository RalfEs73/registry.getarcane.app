# Image-Version (z. B. latest oder eine feste Version)
PLEX_VERSION=latest

# Claim-Token von https://www.plex.tv/claim (nur 4 Minuten gültig, nur beim ersten Start nötig)
PLEX_CLAIM=

# Konfigurationsverzeichnis auf dem Host
PLEX_CONFIG=./plex

# Benutzer- und Gruppen-ID für Dateirechte
PUID=1000
PGID=1000

# Zeitzone
TZ=Europe/Berlin
