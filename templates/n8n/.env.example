# Image-Version (z. B. latest oder eine feste Version)
N8N_VERSION=latest

# Öffentlicher Hostname, unter dem n8n erreichbar ist
N8N_HOST=n8n.example.com

# Port im Container und auf dem Host
N8N_PORT=8443

# Protokoll der öffentlichen URL (https hinter einem Reverse Proxy)
N8N_PROTOCOL=https

# Basis-URL für Webhooks
WEBHOOK_URL=https://n8n.example.com

# true = Login-Cookie nur über HTTPS; auf false setzen, wenn ohne HTTPS zugegriffen wird
N8N_SECURE_COOKIE=true

# Node.js-Module, die in Code-Nodes erlaubt sind
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Zeitzone
TZ=Europe/Berlin

# Datenverzeichnis auf dem Host
N8N_DATA=./data

# Bestehendes externes Docker-Netzwerk (muss vorher angelegt sein)
DOCKER_NETWORK=extern
