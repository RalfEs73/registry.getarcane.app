# Image-Version (z. B. latest oder eine feste Version wie 2)
CADDY_VERSION=latest

# Ports auf dem Host
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Verzeichnis auf dem Host mit data/, config/ und der Datei Caddyfile
CADDY_DIR=./caddy

# Bestehendes externes Docker-Netzwerk (muss vorher angelegt sein)
DOCKER_NETWORK=extern
