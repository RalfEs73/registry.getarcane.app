# Image-Version (z. B. latest oder eine feste Version)
TAUTULLI_VERSION=latest

# Port auf dem Host
TAUTULLI_PORT=8181

# Konfigurationsverzeichnis auf dem Host
TAUTULLI_CONFIG=./config

# Benutzer- und Gruppen-ID für Dateirechte
PUID=1000
PGID=1000

# Zeitzone
TZ=Europe/Berlin

# Bestehendes externes Docker-Netzwerk (muss vorher angelegt sein)
DOCKER_NETWORK=extern
