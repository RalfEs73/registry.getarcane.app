# Image-Tag des Containers
MC_IMAGE_VERSION=latest

# Minecraft-Version (latest, preview oder eine feste Version)
MC_VERSION=latest

# Name des Servers in der Serverliste
SERVER_NAME=BlockSurvival

# UDP-Port im Container und auf dem Host
SERVER_PORT=19142

# Schwierigkeit: peaceful, easy, normal, hard
DIFFICULTY=easy

# true = Spieler müssen bei Xbox Live angemeldet sein
ONLINE_MODE=true

# Operatoren: Gamertags oder XUIDs, durch Komma getrennt (z. B. Spieler1,Spieler2)
OPS=

# true = nur Spieler aus der Allowlist dürfen beitreten
ALLOW_LIST=true

# Allowlist: Gamertag:XUID, durch Komma getrennt (z. B. Spieler1:1234567890)
ALLOW_LIST_USERS=

# Cheats erlauben
ALLOW_CHEATS=true

# Zeitzone
TZ=Europe/Berlin

# Datenverzeichnis auf dem Host (Welt, Einstellungen, Allowlist)
MC_DATA=./minecraft
