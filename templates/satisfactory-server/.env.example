# Image-Tag des Containers
SATISFACTORY_VERSION=latest

# Maximale Anzahl Spieler
MAXPLAYERS=4

# true = experimentelle Spielversion
STEAMBETA=false

# Benutzer- und Gruppen-ID für Dateirechte
PUID=1000
PGID=1000

# Arbeitsspeicher: Obergrenze und reservierter Speicher
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G

# Datenverzeichnis auf dem Host (Spielstände, Serverdateien)
SATISFACTORY_DATA=./satisfactory
